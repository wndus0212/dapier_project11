__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage*
htmlcov/
.venv/
venv/
env/
ENV/

# ROS 2 / colcon workspace outputs
build/
install/
log/
