# Copy to .env. Never commit API keys.
ROUTER_PROVIDER=ollama
ROUTER_MODEL=qwen2.5:7b
WORKER_PROVIDER=ollama
WORKER_MODEL=hermes3:8b
OLLAMA_HOST=http://127.0.0.1:11434
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
MAX_HISTORY=12
NOMI_LLM_TIMEOUT_SECONDS=45

# Remote Laptop Services (Option A: GPU Laptop Architecture)
# OLLAMA_HOST: Host running Ollama (e.g. http://192.168.0.23:11434)
# TOWEL_API_URL: Host running LeRobot towel folding API (e.g. http://192.168.0.23:8100)
# TOWEL_API_TOKEN: Bearer token generated on the laptop
TOWEL_API_URL=http://127.0.0.1:8100
TOWEL_API_TOKEN=
